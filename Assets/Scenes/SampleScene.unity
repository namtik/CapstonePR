--- !u!114 &1879574930
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1879574928}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce22b1ad1fc5b6247977621cc4b41c57, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EventStageController
  event1Canvas: {fileID: 787622923}
  event2Canvas: {fileID: 984449481}
  event1StoryTitleText: {fileID: 1158573598}
  event2StoryTitleText: {fileID: 2053322903}
  event1StoryBodyText: {fileID: 1327849225}
  event2StoryBodyText: {fileID: 245139814}
  useTypewriter: 1
  titleCharactersPerSecond: 10
  bodyCharactersPerSecond: 80
  event1Choice1Button: {fileID: 2102996478}
  event1Choice2Button: {fileID: 529906549}
  event1Choice3Button: {fileID: 59532031}
  event2Choice1Button: {fileID: 400006828}
  event2Choice2Button: {fileID: 1784524353}
  useButtonEntranceAnimation: 1
  elementalCardPool: 64000000c80000002c01000090010000
  exhaustionCardId: 500
  event1Button1Cost: 50
  event1Button1WinChance: 0.4
  event1Button1Reward: 120
  event1Button2HealPercent: 0.2
  resultTexts:
    event1Choice1:
      successBody: "\uC0AC\uBC1C\uC774 \uB4A4\uC9D1\uD78C\uB2E4. \uBC14\uB2E5\uC5D0
        \uC5FD\uC804\uC774 \uC218\uBD81\uC774 \uC313\uC5EC \uC788\uB2E4. \"\uD5C8,
        \uB208\uC774 \uC88B\uC73C\uC2DC\uAD6C\uB824. \u2026\u2026\uC544\uB2C8\uBA74
        \uADF8\uC800 \uC6B4\uC774 \uC88B\uC73C\uC2E0 \uAC70\uACE0.\" \uB178\uC778\uC740
        \uC6C3\uC73C\uBA70 \uC5FD\uC804\uC744 \uBC00\uC5B4\uC900\uB2E4. \uD0DC\uC744\uC740
        \uBC1B\uC544 \uCC59\uAE30\uACE0, \uB354 \uBA38\uBB3C\uC9C0 \uC54A\uB294\uB2E4."
      failureBody: "\uC0AC\uBC1C\uC774 \uB4A4\uC9D1\uD78C\uB2E4. \uBE44\uC5B4 \uC788\uB2E4.
        \uB098\uBA38\uC9C0 \uB458\uC744 \uC5F4\uC5B4 \uBD10\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uB2E4.
        \"\uC774\uB7F0, \uC624\uB298\uC740 \uAE38\uC77C\uC774 \uC544\uB2C8\uC5C8\uB098
        \uBCF4\uC624.\" \uB178\uC778\uC774 \uBE48 \uC0AC\uBC1C\uC744 \uC4F8\uC5B4
        \uB2F4\uB294\uB2E4. \uADF8 \uC190\uB180\uB9BC\uC774 \uCC98\uC74C \uBD24\uC744
        \uB54C\uBCF4\uB2E4 \uBE68\uB77C \uBCF4\uC778\uB2E4. \uD0DC\uC744\uC740 \uC544\uC26C\uC6C0\uC744
        \uAC10\uCD98 \uCC44 \uC790\uB9AC\uB97C \uB72C\uB2E4."
    event1Choice2Body: "\uD0DC\uC744\uC740 \uD654\uB85C \uACC1\uC5D0 \uC549\uB294\uB2E4.
      \uB178\uC778\uC740 \uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uACE0 \uC0AC\uBC1C\uB9CC
      \uB9CC\uC9C0\uC791\uAC70\uB9B0\uB2E4. \uC7A0\uC2DC \uC628\uAE30\uAC00 \uBAB8\uC5D0
      \uC2A4\uBBFC\uB2E4. \uC77C\uC5B4\uC11C\uB294 \uB4F1 \uB4A4\uB85C \uB178\uC778\uC774
      \uB9D0\uD55C\uB2E4. \"\uADF8\uB0E5 \uC26C\uC5B4 \uAC00\uB294 \uC790\uB294 \uC624\uB79C\uB9CC\uC774\uC624.
      \uB2E4\uB4E4 \uBB50\uB4E0 \uAC78\uACE0 \uC2F6\uC5B4 \uC548\uB2EC\uC774\uB358\uB370.\"
      \uD0DC\uC744\uC740 \uB3CC\uC544\uBCF4\uC9C0 \uC54A\uB294\uB2E4."
    event1Choice3Body: "\uC548\uAC1C\uB97C \uD2C8\uD0C0 \uD0DC\uC744\uC758 \uC190\uC774
      \uB178\uC778\uC758 \uC18C\uB9E4\uB85C \uD5A5\uD55C\uB2E4. \uBD80\uC801 \uD55C
      \uC7A5\uC774 \uC190\uB05D\uC5D0 \uC7A1\uD78C\uB2E4. \uADF8 \uC21C\uAC04, \uB178\uC778\uC774
      \uD0A4\uB4DD\uAC70\uB9B0\uB2E4. \"\uAC00\uC838\uAC00\uC2DC\uC624. \uC5B4\uCC28\uD53C
      \uADF8\uAC83\uB3C4 \uB204\uAD70\uAC00\uD55C\uD14C\uC11C \uBC1B\uC740 \uAC70\uB2C8.\"
      \uB4E4\uD0A8 \uAC8C \uC544\uB2C8\uB2E4. \uCC98\uC74C\uBD80\uD130 \uB0B4\uC5B4\uC904
      \uC148\uC774\uC5C8\uB2E4. \uBD80\uC801\uC740 \uC190\uC5D0 \uB4E4\uC5B4\uC654\uC9C0\uB9CC,
      \uBAB8 \uC5B4\uB518\uAC00\uAC00 \uBB35\uC9C1\uD558\uAC8C \uAC00\uB77C\uC549\uB294\uB2E4."
    event2Choice1Body: "\uD0DC\uC744\uC740 \uB9DD\uC124\uC784 \uC5C6\uC774 \uBCF4\uB78F\uBE5B
      \uAE30\uC6B4 \uC18D\uC73C\uB85C \uC190\uC744 \uBC00\uC5B4 \uB123\uB294\uB2E4.
      \uBCC0\uC9C8\uB41C \uC6D0\uC18C\uAC00 \uC190\uBAA9\uC744 \uD0C0\uACE0 \uAE30\uC5B4\uC62C\uB77C
      \uC0B4\uC744 \uD30C\uACE0\uB4E4\uB824 \uD55C\uB2E4. \uADF8\uB7EC\uB098 \uAC01\uC778\uC774
      \uBA3C\uC800 \uBC18\uC751\uD55C\uB2E4. \uC7A0\uC2DD\uD558\uB824\uB358 \uAE30\uC6B4\uC774
      \uB3C4\uB9AC\uC5B4 \uAC08\uB798\uAC08\uB798 \uD480\uB9AC\uBA70 \uD55C \uC7A5\uC758
      \uBD80\uC801\uC73C\uB85C \uC751\uC5B4\uB9AC\uC9C4\uB2E4. \uAC01\uC778 \uC5C6\uB294
      \uC790\uC600\uB2E4\uBA74 \uD314\uBD80\uD130 \uC369\uC5B4 \uB4E4\uC5B4\uAC14\uC744
      \uAC83\uC774\uB2E4. \uD0DC\uC744\uC740 \uBD80\uC801\uC744 \uAEBC\uB0B4 \uCC59\uAE34\uB2E4."
    event2Choice2Body: "\uD0DC\uC744\uC740 \uADA4\uC9DD\uC744 \uD55C \uBC88 \uB0B4\uB824\uB2E4\uBCF8\uB2E4.
      \uBCF4\uB78F\uBE5B \uAE30\uC6B4\uC774 \uB4E4\uC5EC\uB2E4\uBD10 \uB2EC\uB77C\uB294
      \uB4EF \uC77C\uB801\uC778\uB2E4. \uAC00\uB2A0\uD560 \uC218 \uC5C6\uB294 \uAC83\uC5D0\uB294
      \uC190\uB300\uC9C0 \uC54A\uB294\uB2E4. \uD0DC\uC744\uC740 \uADF8\uB300\uB85C
      \uC9C0\uB098\uCE58\uACE0, \uBD80\uC801\uC774 \uBD80\uB52A\uD788\uB294 \uC18C\uB9AC\uAC00
      \uB4F1 \uB4A4\uB85C \uBA40\uC5B4\uC9C4\uB2E4."
  overrideResultTextStyle: 1
  resultTextStyle:
    font: {fileID: 11400000, guid: 6e8a3b84979cd7947b757bfd089bba8b, type: 2}
    fontSize: 38
    color: {r: 0, g: 0, b: 0, a: 1}
    fontStyle: 0
    alignment: 257
    characterSpacing: 0
    lineSpacing: 0
    paragraphSpacing: 0
