  - sprite: {fileID: 21300000, guid: 6de0c9bdddc064c4ba419b40e481fc2a, type: 3}
    displayName: bookre
    description: "\uAC1C\uBC1C\uC911\uC778 \uC720\uBB3C"
  - sprite: {fileID: 21300000, guid: 7c20029f25a7b75439f7e61fc49a5943, type: 3}
    displayName: imugire
    description: "\uAC1C\uBC1C\uC911\uC778 \uC720\uBB3C"
  - sprite: {fileID: 21300000, guid: 02c3dc0ecbb7fb441b0d106f87f0fb5e, type: 3}
    displayName: "\uD30C\uCD08\uC120"
    description: "\uAC70\uB300\uD55C \uB3CC\uD48D\uACFC \uD654\uC5FC\uC744 \uC77C\uC73C\uD0A8\uB2E4\uACE0
      \uC804\uD574\uC9C0\uB294 \uC804\uC124 \uC18D\uC758 \uBD80\uCC44. \uACF5\uACA9
      \uCE74\uB4DC\uB97C \uC0AC\uC6A9\uD560 \uB54C\uB9C8\uB2E4 \uC801 \uC804\uCCB4\uC5D0\uAC8C
      '\uD654\uC0C1' \uB514\uBC84\uD504\uB97C 2\uC2A4\uD0DD \uBD80\uC5EC\uD55C\uB2E4."
  - sprite: {fileID: 21300000, guid: 4837f7ca73d526b45b3c61d1740b68af, type: 3}
    displayName: "\uCCAD\uB3D9 \uBC29\uC6B8"
    description: "\uB9D1\uC740 \uC18C\uB9AC\uB85C \uC545\uADC0\uB97C \uCAD3\uACE0
      \uC815\uC2E0\uC744 \uB9D1\uAC8C \uD574\uC8FC\uB294 \uBB34\uB2F9\uC758 \uBC29\uC6B8.
      \uC801\uC774 \uD50C\uB808\uC774\uC5B4\uC758 \uB371\uC5D0 '\uC0C1\uD0DC \uC774\uC0C1(\uC800\uC8FC,
      \uD658\uAC01, \uBC29\uD574 \uB4F1)' \uCE74\uB4DC\uB97C \uC11E\uC5B4 \uB123\uC744
      \uB54C, \uB9E4 \uC804\uD22C\uB9C8\uB2E4 \uCC98\uC74C 2\uC7A5\uC758 \uC0C1\uD0DC
      \uC774\uC0C1 \uCE74\uB4DC\uB97C \uC989\uC2DC \uC18C\uBA78\uC2DC\uD0A8\uB2E4."
  - sprite: {fileID: 21300000, guid: a1b629094b05b38419d022bf9bfb604c, type: 3}
    displayName: "\uACE1\uC625 \uB178\uB9AC\uAC1C"
    description: "\uC751\uCD95\uB41C \uAE30\uC6B4\uC744 \uD488\uACE0 \uC788\uB294
      \uCD08\uC2B9\uB2EC \uBAA8\uC591\uC758 \uC625 \uC7A5\uC2E0\uAD6C. \uAC01\uC131
      \uC885\uB8CC \uC2DC \uAC01\uC131 \uAC8C\uC774\uC9C0\uB97C 2\uD68D\uB4DD\uD55C\uB2E4. "
  - sprite: {fileID: 21300000, guid: dab66d242cc55714ea23e06d5e890c03, type: 3}
    displayName: "\uBE44\uD30C \uAC80"
    description: "\uC544\uB984\uB2E4\uC6B4 \uC120\uC728 \uC18D\uC5D0 \uB0A0\uCE74\uB85C\uC6B4
      \uC0B4\uC758\uB97C \uAC10\uCD98 \uC545\uAE30 \uD615\uD0DC\uC758 \uAC80. \uD295\uAE30\uB294
      \uC904\uC758 \uC9C4\uB3D9\uC774 \uACE7 \uBCA0\uC5B4\uB0B4\uB294 \uCE7C\uB0A0\uC774
      \uB41C\uB2E4. \uC5F0\uC1C4\uAC00 \uC911\uCCA9 \uB420 \uB54C\uB9C8\uB2E4, \uC911\uCCA9\uC5D0
      \uBE44\uB840\uD55C \uD53C\uD574\uB97C \uBAA8\uB4E0 \uC801\uC5D0\uAC8C \uC785\uD78C\uB2E4."
  - sprite: {fileID: 21300000, guid: 01fc74aed5cd63848bd0b5232ffcf454, type: 3}
    displayName: "\uD574\uD0DC \uC11D\uC870\uC0C1"
    description: "\uD654\uB9C8\uC640 \uC7AC\uC559\uC744 \uB9C9\uC544\uC8FC\uB294
      \uC601\uBB3C \uD574\uD0DC\uB97C \uC870\uAC01\uD55C \uB4E0\uB4E0\uD55C \uC218\uD638\uC11D.
      \uC804\uD22C \uC911 \uCCB4\uB825\uC774 30% \uC774\uD558\uB85C \uB5A8\uC5B4\uC9C0\uBA74
      \uC801\uC758 \uACF5\uACA9\uC744 1\uD68C \uBC29\uC5B4\uD558\uB294 \uBCF4\uD638\uB9C9\uC744
      \uC804\uAC1C\uD55C\uB2E4. "
  - sprite: {fileID: 21300000, guid: cfa987965e7d7a448b3aae5be8e28a1c, type: 3}
    displayName: "\uADC0\uBA74 \uBC29\uD328"
    description: "\uC801\uC758 \uACF5\uACA9\uC744 \uBC29\uC5B4 \uD560 \uB54C\uB9C8\uB2E4
      \uBC29\uC5B4\uD55C \uACF5\uACA9\uC758 30%\uC5D0 \uD574\uB2F9\uD558\uB294 \uB370\uBBF8\uC9C0\uB97C
      \uD574\uB2F9 \uC801\uC5D0\uAC8C \uC785\uD78C\uB2E4."
