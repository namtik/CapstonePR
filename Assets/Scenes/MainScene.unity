  m_text: "\uAE38\uAC00 \uD55C\uBCF5\uD310\uC5D0 \uAE30\uAD34\uD55C \uBCF4\uB78F\uBE5B
    \uAE30\uC6B4\uC774 \uD758\uB7EC \uB118\uCE58\uB294 \uC815\uCCB4 \uBAA8\uB97C
    \uADA4\uC9DD\uC774 \uB369\uADF8\uB7EC\uB2C8 \uB193\uC5EC \uC788\uC2B5\uB2C8\uB2E4.\r\n\uAC00\uAE4C\uC774
    \uB2E4\uAC00\uAC00\uC790 \uB0B4\uBD80\uC5D0\uC11C \uC6D0\uC18C\uB4E4\uC774 \uC81C\uBA4B\uB300\uB85C
