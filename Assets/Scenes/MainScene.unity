  event5Choice1Button: {fileID: 1518695648}
  event5Choice2Button: {fileID: 1872574862}
  event3Choice1Button: {fileID: 1800141774}
  event3Choice2Button: {fileID: 1960787532}
  event3Branch1Choice1Button: {fileID: 1001424527}
  event3Branch1Choice2Button: {fileID: 1666831118}
  event3Branch2Choice1Button: {fileID: 1277960562}
  event3Branch2Choice2Button: {fileID: 420696888}
  useButtonEntranceAnimation: 1
  elementalCardPool: 64000000c80000002c01000090010000
  exhaustionCardId: 500
  event1Button1Cost: 50
  event1Button1WinChance: 0.4
  event1Button1Reward: 120
  event1Button2HealPercent: 0.2
  event3Branch2Choice1Reward: 200
  event3Branch1Choice1ComboFormat: "\uD68D\uB4DD: {0}"
  event4RemoveCardCount: 3
  event4RemovedCardsFormat: "\uC81C\uAC70: {0}"
  event5CardViewPrefab: {fileID: -2451704214461003869, guid: 85aab6364ddd64b4ca9e868a807b40e2, type: 3}
  event5CardPickContainer: {fileID: 0}
  event5CardPickTitle: "\uBCC0\uD654\uC2DC\uD0AC \uAE30\uBCF8 \uCE74\uB4DC\uB97C
    \uC120\uD0DD\uD558\uC138\uC694"
  event5CardPickTitleFont: {fileID: 11400000, guid: 6e8a3b84979cd7947b757bfd089bba8b, type: 2}
  event5CardPickTitleFontSize: 32
  event5CardPickTitleColor: {r: 0, g: 0, b: 0, a: 1}
  event5CardPickScale: 1.35
  event5CardPickSpacing: 280
  event5CardPickEnableHoverScale: 1
  event5CardPickHoverScale: 1.08
  event5CardPickHoverLerpSpeed: 14
  event5TransformResultFormat: "<b>{0} \uC81C\uAC70 \\n{1} \uD68D\uB4DD</b>"
  goldRewardIcon: {fileID: 21300000, guid: 4f314a0b3683b014b9f26988b908f4b1, type: 3}
  fallbackToMoneyManagerIcon: 1
  goldRewardIconSize: 48
  goldRewardRowSpacing: 50
  goldRewardIconTextSpacing: 8
  goldRewardAmountFormat: +{0}
  goldRewardFont: {fileID: 11400000, guid: 624ba3875d81cfd41b8f6058c7c3e447, type: 2}
  goldRewardFontSize: 0
  useGoldRewardFontColor: 1
  goldRewardFontColor: {r: 0, g: 0, b: 0, a: 1}
  resultTexts:
    event1Choice1:
      successBody: "\uC0AC\uBC1C\uC774 \uB4A4\uC9D1\uD78C\uB2E4. \uBC14\uB2E5\uC5D0
        \uC5FD\uC804\uC774 \uC218\uBD81\uC774 \uC313\uC5EC \uC788\uB2E4. \"\uD5C8,
        \uB208\uC774 \uC88B\uC73C\uC2DC\uAD6C\uB824. \u2026\u2026\uC544\uB2C8\uBA74
        \uADF8\uC800 \uC6B4\uC774 \uC88B\uC73C\uC2E0 \uAC70\uACE0.\" \uB178\uC778\uC740
        \uC6C3\uC73C\uBA70 \uC5FD\uC804\uC744 \uBC00\uC5B4\uC900\uB2E4. \uD0DC\uC744\uC740
        \uBC1B\uC544 \uCC59\uAE30\uACE0, \uB354 \uBA38\uBB3C\uC9C0 \uC54A\uB294\uB2E4."
      failureBody: "\uC0AC\uBC1C\uC774 \uB4A4\uC9D1\uD78C\uB2E4. \uBE44\uC5B4 \uC788\uB2E4.
        \uB098\uBA38\uC9C0 \uB458\uC744 \uC5F4\uC5B4 \uBD10\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uB2E4.
        \"\uC774\uB7F0, \uC624\uB298\uC740 \uAE38\uC77C\uC774 \uC544\uB2C8\uC5C8\uB098
        \uBCF4\uC624.\" \uB178\uC778\uC774 \uBE48 \uC0AC\uBC1C\uC744 \uC4F8\uC5B4
        \uB2F4\uB294\uB2E4. \uADF8 \uC190\uB180\uB9BC\uC774 \uCC98\uC74C \uBD24\uC744
        \uB54C\uBCF4\uB2E4 \uBE68\uB77C \uBCF4\uC778\uB2E4. \uD0DC\uC744\uC740 \uC544\uC26C\uC6C0\uC744
        \uAC10\uCD98 \uCC44 \uC790\uB9AC\uB97C \uB72C\uB2E4."
    event1Choice2Body: "\uD0DC\uC744\uC740 \uD654\uB85C \uACC1\uC5D0 \uC549\uB294\uB2E4.
      \uB178\uC778\uC740 \uC544\uBB34\uAC83\uB3C4 \uBB3B\uC9C0 \uC54A\uACE0 \uC0AC\uBC1C\uB9CC
      \uB9CC\uC9C0\uC791\uAC70\uB9B0\uB2E4. \uC7A0\uC2DC \uC628\uAE30\uAC00 \uBAB8\uC5D0
      \uC2A4\uBBFC\uB2E4. \uC77C\uC5B4\uC11C\uB294 \uB4F1 \uB4A4\uB85C \uB178\uC778\uC774
      \uB9D0\uD55C\uB2E4. \"\uADF8\uB0E5 \uC26C\uC5B4 \uAC00\uB294 \uC790\uB294 \uC624\uB79C\uB9CC\uC774\uC624.
      \uB2E4\uB4E4 \uBB50\uB4E0 \uAC78\uACE0 \uC2F6\uC5B4 \uC548\uB2EC\uC774\uB358\uB370.\"
      \uD0DC\uC744\uC740 \uB3CC\uC544\uBCF4\uC9C0 \uC54A\uB294\uB2E4."
    event1Choice3Body: "\uC548\uAC1C\uB97C \uD2C8\uD0C0 \uD0DC\uC744\uC758 \uC190\uC774
      \uB178\uC778\uC758 \uC18C\uB9E4\uB85C \uD5A5\uD55C\uB2E4. \uBD80\uC801 \uD55C
      \uC7A5\uC774 \uC190\uB05D\uC5D0 \uC7A1\uD78C\uB2E4. \uADF8 \uC21C\uAC04, \uB178\uC778\uC774
      \uD0A4\uB4DD\uAC70\uB9B0\uB2E4. \"\uAC00\uC838\uAC00\uC2DC\uC624. \uC5B4\uCC28\uD53C
      \uADF8\uAC83\uB3C4 \uB204\uAD70\uAC00\uD55C\uD14C\uC11C \uBC1B\uC740 \uAC70\uB2C8.\"
      \uB4E4\uD0A8 \uAC8C \uC544\uB2C8\uB2E4. \uCC98\uC74C\uBD80\uD130 \uB0B4\uC5B4\uC904
      \uC148\uC774\uC5C8\uB2E4. \uBD80\uC801\uC740 \uC190\uC5D0 \uB4E4\uC5B4\uC654\uC9C0\uB9CC,
      \uBAB8 \uC5B4\uB518\uAC00\uAC00 \uBB35\uC9C1\uD558\uAC8C \uAC00\uB77C\uC549\uB294\uB2E4."
    event2Choice1Body: "\uD0DC\uC744\uC740 \uB9DD\uC124\uC784 \uC5C6\uC774 \uBCF4\uB78F\uBE5B
      \uAE30\uC6B4 \uC18D\uC73C\uB85C \uC190\uC744 \uBC00\uC5B4 \uB123\uB294\uB2E4.
      \uBCC0\uC9C8\uB41C \uC6D0\uC18C\uAC00 \uC190\uBAA9\uC744 \uD0C0\uACE0 \uAE30\uC5B4\uC62C\uB77C
      \uC0B4\uC744 \uD30C\uACE0\uB4E4\uB824 \uD55C\uB2E4. \uADF8\uB7EC\uB098 \uAC01\uC778\uC774
      \uBA3C\uC800 \uBC18\uC751\uD55C\uB2E4. \uC7A0\uC2DD\uD558\uB824\uB358 \uAE30\uC6B4\uC774
      \uB3C4\uB9AC\uC5B4 \uAC08\uB798\uAC08\uB798 \uD480\uB9AC\uBA70 \uD55C \uC7A5\uC758
      \uBD80\uC801\uC73C\uB85C \uC751\uC5B4\uB9AC\uC9C4\uB2E4. \uAC01\uC778 \uC5C6\uB294
      \uC790\uC600\uB2E4\uBA74 \uD314\uBD80\uD130 \uC369\uC5B4 \uB4E4\uC5B4\uAC14\uC744
      \uAC83\uC774\uB2E4. \uD0DC\uC744\uC740 \uBD80\uC801\uC744 \uAEBC\uB0B4 \uCC59\uAE34\uB2E4."
    event2Choice2Body: "\uD0DC\uC744\uC740 \uADA4\uC9DD\uC744 \uD55C \uBC88 \uB0B4\uB824\uB2E4\uBCF8\uB2E4.
      \uBCF4\uB78F\uBE5B \uAE30\uC6B4\uC774 \uB4E4\uC5EC\uB2E4\uBD10 \uB2EC\uB77C\uB294
      \uB4EF \uC77C\uB801\uC778\uB2E4. \uAC00\uB2A0\uD560 \uC218 \uC5C6\uB294 \uAC83\uC5D0\uB294
      \uC190\uB300\uC9C0 \uC54A\uB294\uB2E4. \uD0DC\uC744\uC740 \uADF8\uB300\uB85C
      \uC9C0\uB098\uCE58\uACE0, \uBD80\uC801\uC774 \uBD80\uB52A\uD788\uB294 \uC18C\uB9AC\uAC00
      \uB4F1 \uB4A4\uB85C \uBA40\uC5B4\uC9C4\uB2E4."
    event3Branch1IntroBody: "\uC8FC\uC704 \uC18C\uB9AC\uC5D0 \uACBD\uACC4\uD558\uBA70
      \uB098\uC544\uAC04\uB2E4. \uB098\uC544\uAC00\uBA74 \uB098\uC544\uAC08\uC218\uB85D
      \uC54C \uC218 \uC5C6\uB294 \uAE08\uC18D\uC74C\uACFC \uD3ED\uBC1C\uC74C\uC774
      \uCEE4\uC838\uC628\uB2E4. \uC18C\uB9AC\uC5D0 \uC9D1\uC911\uD558\uBA70 \uB098\uC544\uAC00\uB2E4
      \uB610 \uB2E4\uC2DC \uB450\uAC08\uB798 \uAE38\uC774 \uB098\uD0C0\uB0AC\uB2E4.
      \uC5EC\uC804\uD788 \uC624\uB978\uCABD \uAE38\uC5D0\uC11C\uB294 \uC54C \uC218
      \uC5C6\uB294 \uC18C\uC74C\uC774 \uB4E4\uB9AC\uBA70 \uC67C\uCABD \uAE38\uC5D0\uC11C\uB294
      \uC950 \uC8FD\uC740 \uB4EF\uC774 \uC544\uBB34\uB7F0 \uC18C\uB9AC\uB3C4 \uB4E4\uB9AC\uC9C0
      \uC54A\uB294\uB2E4."
    event3Branch2IntroBody: "\uC544\uBB34 \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uC9C0 \uC54A\uB294
      \uBE44\uAD50\uC801 \uC548\uC804\uD574\uBCF4\uC774\uB294 \uAE38\uB85C \uD5A5\uD55C\uB2E4.
      \uADF8\uB7EC\uB098 \uB098\uC544\uAC00\uBA74 \uB098\uC544\uAC08\uC218\uB85D
      \uC548\uAC1C\uAC00 \uC810\uC810 \uC9D9\uC5B4\uC838 \uD55C\uCE58 \uC55E\uB3C4
      \uBCF4\uC774\uC9C0 \uC54A\uACE0 \uBC29\uD5A5\uB3C4 \uC783\uC5B4\uBC84\uB9B0
      \uAC83 \uAC19\uB2E4"
    event3Branch1Choice1Body: "\uD0DC\uC744\uC740 \uC6A9\uAE30\uB97C \uB0B4\uC5B4
      \uC18C\uC74C\uC774 \uB098\uB294 \uACF3\uC73C\uB85C \uD5A5\uD55C\uB2E4. \uAC78\uC5B4\uAC00\uBA74
      \uAC78\uC5B4 \uAC08 \uC218\uB85D \uB728\uAC70\uC6B4 \uC5F4\uAE30\uC640 \uCE7C\uBC14\uB78C\uC774
      \uD0DC\uC744\uC744 \uB36E\uCE58\uBA70 \uC124\uC0C1\uAC00\uC0C1\uC73C\uB85C
      \uC548\uAC1C\uAE4C\uC9C0 \uC9D9\uC5B4\uC838 \uD55C \uCE58 \uC55E\uC744 \uC54C\uC544
      \uBCFC \uC218 \uC5C6\uB294 \uC0C1\uD0DC\uAC00 \uB418\uC5C8\uB2E4.\r\n{\uCCB4\uB825
      -10}\r\n\uADF8\uB7FC\uC5D0\uB3C4 \uD3EC\uAE30\uD558\uC9C0 \uC54A\uACE0 \uB098\uC544\uAC00
      \uADF8 \uC18C\uC74C\uC758 \uB05D\uC5D0 \uB2E4\uB2E4\uB974\uC790 \uC548\uAC1C
      \uC0AC\uC774\uC5D0 \uC120\uBA85\uD558\uAC8C \uD55C \uBE44\uAE09\uC11C\uAC00
      \uBCF4\uC778\uB2E4. \uADF8\uAC83\uC73C\uB85C \uC190\uC744 \uBED7\uC790 \uAC11\uC790\uAE30
      \uC8FC\uC704\uC758 \uC548\uAC1C\uAC00 \uAE68\uB057\uD558\uAC8C \uAC77\uD78C\uB2E4."
    event3Branch1Choice2Body: "\uC704\uD611\uC801\uC778 \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uB294
      \uC624\uB978\uCABD \uAE38\uC744 \uB4A4\uB85C\uD558\uACE0 \uC67C\uCABD\uC73C\uB85C
      \uD5A5\uD588\uB2E4. \uC18C\uC74C\uC774 \uC810\uC810 \uBA40\uC5B4\uC9C0\uB294
      \uAC83\uC744 \uB290\uB07C\uBA70 \uB098\uC544\uAC08\uC218\uB85D \uC548\uAC1C\uB3C4
      \uAC77\uD788\uACE0 \uC788\uB2E4. \uBB34\uC0AC\uD788 \uBE60\uC838 \uB098\uAC04
      \uAC83 \uAC19\uB2E4."
    event3Branch2Choice1Body: "\uD0DC\uC744\uC740 \uB4A4\uB3CC\uC544\uAC00\uC9C0
      \uC54A\uACE0 \uB354\uC6B1 \uAE4A\uC740 \uC548\uAC1C \uC18D\uC73C\uB85C \uBC1C\uC744
      \uB0B4\uB514\uB3A0\uB2E4. \uCC98\uC74C\uC5D0\uB294 \uC544\uBB34 \uC77C\uB3C4
      \uC77C\uC5B4\uB098\uC9C0 \uC54A\uB294 \uB4EF\uD588\uC9C0\uB9CC, \uACE7 \uC0AC\uBC29\uC5D0\uC11C
      \uAC19\uC740 \uB098\uBB34\uC640 \uAC19\uC740 \uBC14\uC704\uAC00 \uBC18\uBCF5\uD574\uC11C
      \uB098\uD0C0\uB098\uAE30 \uC2DC\uC791\uD588\uB2E4. \uBC29\uD5A5\uC744 \uC783\uC5C8\uB2E4\uB294
      \uC0AC\uC2E4\uC744 \uAE68\uB2EC\uC740 \uC21C\uAC04, \uC548\uAC1C \uC18D\uC5D0\uC11C
      \uC624\uC5FC\uB418\uC9C0 \uC54A\uC740 \uBC14\uB78C\uC774 \uBD88\uC5B4\uC624\uB294
      \uAC83\uC744 \uB290\uB080\uB2E4. \uC774\uAC83\uC744 \uB530\uB77C\uAC00\uB2E4
      \uBCF4\uB2C8 \uC810\uC810 \uC548\uAC1C\uAC00 \uAC77\uD78C\uB2E4. \uC232\uC5D0\uC11C
      \uBE60\uC838\uB098\uC62C \uB54C \uC988\uC74C\uC5D0 \uBC14\uB78C\uC758 \uAE30\uC6B4\uC744
      \uBA38\uAE08\uC740 \uC218\uD589\uC790\uC758 \uD574\uACE8\uC744 \uBC1C\uACAC\uD55C\uB2E4.
      \uADF8\uB7EC\uC790 \uD574\uACE8\uC774 \uD759\uC73C\uB85C \uBCC0\uD558\uBA70
      \uC0AC\uB77C\uC9C4\uB2E4. \uD0DC\uC744\uC740 \uADF8\uAC83\uC5D0\uAC8C \uAC10\uC0AC\uC778\uC0AC\uB97C
      \uC62C\uB9AC\uBA70 \uC218\uD589\uC790\uC758 \uBCF4\uB530\uB9AC\uB97C \uCC59\uAE34\uB2E4."
    event3Branch2Choice2Body: "\uD0DC\uC744\uC740 \uB354 \uAE4A\uC774 \uB4E4\uC5B4\uAC00\uB294
      \uAC83\uC744 \uD3EC\uAE30\uD558\uACE0 \uC654\uB358 \uAE38\uC744 \uB418\uC9DA\uC5B4
      \uB3CC\uC544\uAC00\uAE30\r\n\uC2DC\uC791\uD588\uB2E4. \uD558\uC9C0\uB9CC \uC774\uC0C1\uD558\uAC8C\uB3C4
      \uB4A4\uB85C \uAC78\uC744\uC218\uB85D \uAE38\uC740 \uC810\uC810 \uB0AF\uC124\uC5B4\uC84C\uB2E4.
      \uBC29\uAE08 \uC804\uAE4C\uC9C0 \uBC1F\uACE0 \uC9C0\uB098\uC628 \uD759\uAE38\uC740
      \uC0AC\uB77C\uC9C0\uACE0, \uB098\uBB34\uC758 \uD615\uD0DC\uB3C4 \uC870\uAE08\uC529
      \uB4A4\uD2C0\uB824 \uC788\uC5C8\uB2E4. \uBC1C\uC790\uAD6D\uC740 \uAC80\uC740
      \uC548\uAC1C\uC5D0 \uC0BC\uCF1C\uC9C4 \uB4EF \uD754\uC801\uC870\uCC28 \uB0A8\uC544
      \uC788\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB54C, \uC548\uAC1C \uC18D\uC5D0\uC11C
      \uD478\uB978\uBE5B\uC744 \uC783\uC740 \uBC14\uB78C\uC758 \uC6D0\uC18C\uAC00
      \uCC9C\uCC9C\uD788 \uB5A0\uC62C\uB790\uB2E4. \uADF8 \uC6D0\uC18C\uB294 \uBE60\uB974\uAC8C
      \uD0DC\uC744\uC5D0\uAC8C \uC811\uADFC\uD574 \uBAB8 \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC04\uB2E4.
      \uC21C\uAC04 \uD0DC\uC744\uC740 \uCC28\uAC00\uC6B4 \uBC14\uB78C\uC774 \uC628\uBAB8\uC744
      \uD30C\uACE0\uB4E4\uC5B4 \uC815\uC2E0\uC744 \uC783\uB294\uB2E4.\r\n{\uC624\uC5FC\uB41C
      \uC6D0\uC18C \uCE74\uB4DC \uD68D\uB4DD}\r\n\uC815\uC2E0\uC744 \uCC28\uB838\uC744
      \uB54C\uB294 \uC774\uBBF8 \uBAA8\uB4E0 \uC548\uAC1C\uAC00 \uAC77\uD78C \uC774\uD6C4\uC600\uB2E4."
    event4Choice1Body: "\uD0DC\uC744\uC740 \uB9DD\uC124\uC784 \uB05D\uC5D0 \uD5A5\uB85C\uC5D0
      \uC190\uC744 \uAC00\uC838\uAC00 \uB304\uB2E4.\n\uADF8\uB7EC\uC790 \uD5A5\uB85C\uC758
      \uAC80\uC740 \uC7AC\uAC00 \uBC14\uB78C\uB3C4 \uC5C6\uC774 \uD53C\uC5B4\uC624\uB974\uBA70,
      \uD0DC\uC744\uC744 \uAC10\uC2F8\uAE30 \uC2DC\uC791\uD55C\uB2E4.\r\n\uD0DC\uC744\uC740
      \uBB34\uC5C7\uC778\uAC00 \uC78A\uC740\uAC83 \uAC19\uC9C0\uB9CC \uAE30\uC5B5\uC774
      \uB098\uC9C0 \uC54A\uC544 \uC758\uBB38\uB9CC\uC744 \uB0A8\uAE34\uCC44 \uC0AC\uB2F9\uC744
      \uB5A0\uB09C\uB2E4."
    event4Choice2Body: "\uD0DC\uC744\uC740 \uD5A5\uB85C\uC5D0\uC11C \uC190\uC744
      \uAC70\uB450\uC5C8\uB2E4. \n\uC9C0\uC6CC\uB0BC \uC218 \uC788\uB294 \uAC83\uB3C4
      \uD798\uC774\uC9C0\uB9CC, \uBC84\uD2F0\uACE0 \uC9CA\uC5B4\uC9C0\uB294 \uAC83
      \uB610\uD55C \uC218\uD589\uC774\uB77C \uC0DD\uAC01\uD588\uAE30 \uB54C\uBB38\uC774\uB2E4.
      \n\uD5A5\uB85C\uC758 \uC7AC\uB294 \uC7A0\uC2DC \uD754\uB4E4\uB9AC\uB354\uB2C8
      \uC774\uB0B4 \uC870\uC6A9\uD788 \uAC00\uB77C\uC549\uC558\uB2E4. \n\uC0AC\uB2F9
      \uC548\uC5D0\uB294 \uB2E4\uC2DC \uC605\uC740 \uD5A5 \uB0C4\uC0C8\uB9CC\uC774
      \uB0A8\uC558\uB2E4. \n\uD0DC\uC744\uC740 \uC544\uBB34\uAC83\uB3C4 \uC783\uC9C0
      \uC54A\uC740 \uCC44 \uC0AC\uB2F9\uC744 \uBE60\uC838\uB098\uC654\uB2E4."
    event5Choice1Body: "\uC218\uC5C6\uC774 \uBC18\uBCF5\uD574\uC628 \uAE30\uBCF8\uAE30\uC600\uC9C0\uB9CC,
      \uC9C0\uAE08\uC758 \uAE38\uC5D0\uC11C\uB294 \uB354 \uC774\uC0C1 \uC608\uC804
      \uBAA8\uC2B5 \uADF8\uB300\uB85C \uBA38\uBB34\uB97C \uC218 \uC5C6\uC5C8\uB2E4.
      \n\uBAA9\uC778\uC7A5\uC5D0 \uC190\uC744 \uB300\uB294 \uC21C\uAC04, \uB098\uBB34\uC5D0
      \uC0C8\uACA8\uC9C4 \uCE7C\uC790\uAD6D\uB4E4\uC774 \uBE5B\uC744 \uB0B4\uBA70
      \uD0DC\uC744\uC758 \uBAB8 \uC548\uC73C\uB85C \uC2A4\uBA70\uB4E4\uC5C8\uB2E4.\n\uB0A1\uC740
      \uAE30\uBCF8\uAE30\uB294 \uC0AC\uB77C\uC84C\uC9C0\uB9CC, \uADF8 \uC790\uB9AC\uC5D0
      \uB354 \uB0A0\uCE74\uB85C\uC6B4 \uD798\uC774 \uB0A8\uC558\uB2E4."
    event5Choice2Body: "\uD0DC\uC744\uC740 \uC0AC\uC2E0\uC218\uC5D0\uAC8C \uC804\uC218\uBC1B\uC740
      \uC6D0\uC18C\uB4E4\uC758 \uAE30\uBCF8\uAE30\uB97C \uC218\uB828\uD55C\uB2E4.
      \uBAA9\uC778\uC7A5\uC758 \uC0C1\uCC98\uB4E4\uC740 \uC7A0\uC2DC \uBE5B\uC744
      \uB0B4\uB2E4 \uC774\uB0B4 \uC870\uC6A9\uD788 \uAC00\uB77C\uC549\uC558\uB2E4.\n\r\n<b>{\uAE30\uBCF8
      \uCE74\uB4DC \uD53C\uD574 X2}</b>\r\n<b>{\uAE30\uBCF8 \uCE74\uB4DC \uBC29\uC5B4\uB3C4
      X2}</b>\n\r\n\uBCC0\uD654\uC758 \uAE30\uD68C\uB294 \uC0AC\uB77C\uC84C\uC9C0\uB9CC,
      \uD0DC\uC744\uC758 \uBAB8\uC5D0\uB294 \uC775\uC219\uD568\uC774 \uB0A8\uC558\uB2E4.
      \n\n\uD0DC\uC744\uC740 \uB2E4\uC2DC \uAE38\uC744 \uB098\uC120\uB2E4."
    event5Choice1NoBasicBody: "\uAE30\uBCF8 \uCE74\uB4DC\uB97C \uBCF4\uC720\uD558\uC9C0
      \uC54A\uC558\uB2E4."
    event5Choice1FailedBody: '-'
  overrideResultTextStyle: 1
  resultTextStyle:
    font: {fileID: 11400000, guid: 6e8a3b84979cd7947b757bfd089bba8b, type: 2}
