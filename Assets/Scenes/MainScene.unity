    \n\uD5A5\uB85C \uC704\uC5D0\uB294 \uC624\uB798\uB41C \uAE00\uADC0\uAC00 \uC0C8\uACA8\uC838
    \uC788\uB2E4. \n\u201C\uBC84\uB9AC\uC9C0 \uBABB\uD55C \uAC83\uC740 \uC9D0\uC774
    \uB418\uACE0, \uD0DC\uC6CC\uB0B8 \uAC83\uC740 \uAE38\uC774 \uB41C\uB2E4.\u201D\r\n\uD5A5\uB85C\uC758
