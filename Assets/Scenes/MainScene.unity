  m_text: "\uC624\uC5FC\uB41C \uBC14\uB78C\uC758 \uC6D0\uC18C\uB85C \uC778\uD574
    \uBC1C\uC0DD\uD55C \uC9D9\uC740 \uC548\uAC1C\uAC00 \uAE38\uC744 \uC9D1\uC5B4
    \uC0BC\uD0A4\uACE0 \uC788\uB2E4. \uD55C\uCE58 \uC55E\uB3C4 \uBCF4\uC774\uC9C0
    \uC54A\uB294 \uC0C1\uD669\uC5D0\uC11C \uB450 \uAC08\uB798 \uAE38\uC774 \uB098\uD0C0\uB0AC\uB2E4.
